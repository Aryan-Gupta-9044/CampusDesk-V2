# Copy to .env and fill in (Supabase Dashboard -> Project Settings -> API).
# ONLY the anon / publishable key belongs here. NEVER put the service_role key in the frontend.
# Variables are injected at BUILD time (npm start / npm run build).
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Optional - GitHub Pages project-site base path, e.g. /CampusDesk/
# VITE_BASE_PATH=/CampusDesk/

# Optional - create teachers/students/parents through the `create-user` Edge Function
# (recommended once deployed; see docs/DATABASE_SETUP.md). Default: off.
# REACT_APP_USE_EDGE_FUNCTIONS=true
